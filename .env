# Public, non-secret build settings. Override per environment in .env.local or your host's env vars.

# Absolute origin used for canonical/Open Graph URLs (no trailing slash).
VITE_SITE_URL=https://abdoelbeherey.dev

# Optional JSON form endpoint (e.g. https://formspree.io/f/xxxx). When empty, the contact
# form opens a pre-filled email to the address in src/content/site.ts.
VITE_CONTACT_ENDPOINT=
